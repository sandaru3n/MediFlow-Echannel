# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (shipped to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (used by route handlers; never exposed to the client) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Long random string used to hash one-time codes (e.g. `openssl rand -hex 32`)
OTP_SECRET=change-me-to-a-long-random-string
# Domain for the internal email address given to phone-only accounts
PHONE_USER_EMAIL_DOMAIN=phone.mediflow.example.com

# SMS via Notify.lk (optional in development)
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

# Email via Resend (optional in development)
RESEND_API_KEY=
EMAIL_FROM="Medi Flow <no-reply@your-domain.lk>"

# When no SMS/email provider is configured, development mode shows the code on screen.
# Keep this false in production.
OTP_DEV_MODE=false
